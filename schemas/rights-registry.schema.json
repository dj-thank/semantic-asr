{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-asr.invalid/schemas/rights-registry.schema.json",
  "title": "Semantic ASR rights registry v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "registryDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "assetId",
          "sourceName",
          "sourceUrl",
          "version",
          "licenseName",
          "licenseUrl",
          "train",
          "evaluate",
          "deriveFeatures",
          "publishText",
          "publishFeatures",
          "publishWeights",
          "redistributeAudio",
          "redistributeRaw",
          "exportSpeakerId",
          "attribution",
          "reviewedAt",
          "acquiredAt"
        ],
        "properties": {
          "assetId": {
            "type": "string",
            "minLength": 1
          },
          "sourceName": {
            "type": "string",
            "minLength": 1
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "licenseName": {
            "type": "string",
            "minLength": 1
          },
          "licenseUrl": {
            "type": "string",
            "format": "uri"
          },
          "train": {
            "$ref": "#/$defs/state"
          },
          "evaluate": {
            "$ref": "#/$defs/state"
          },
          "deriveFeatures": {
            "$ref": "#/$defs/state"
          },
          "publishText": {
            "$ref": "#/$defs/state"
          },
          "publishFeatures": {
            "$ref": "#/$defs/state"
          },
          "publishWeights": {
            "$ref": "#/$defs/state"
          },
          "redistributeAudio": {
            "$ref": "#/$defs/state"
          },
          "redistributeRaw": {
            "$ref": "#/$defs/state"
          },
          "exportSpeakerId": {
            "$ref": "#/$defs/state"
          },
          "attribution": {
            "type": "string",
            "minLength": 1
          },
          "reviewedAt": {
            "type": "string",
            "minLength": 1
          },
          "acquiredAt": {
            "type": "string",
            "minLength": 1
          },
          "licenseTextSha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "consentRecord": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "state": {
      "enum": [
        "allow",
        "deny",
        "review"
      ]
    }
  },
  "additionalProperties": false
}
