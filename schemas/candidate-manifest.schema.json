{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-asr.invalid/schemas/candidate-manifest.schema.json",
  "title": "Semantic ASR candidate manifest",
  "type": "object",
  "required": ["candidates"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "score": { "type": ["number", "null"] },
    "candidate": {
      "type": "object",
      "required": ["candidateId", "text"],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "tokenIds": { "type": "array", "items": { "type": "integer" } },
        "acoustic": { "$ref": "#/$defs/score" },
        "mora": { "$ref": "#/$defs/score" },
        "lexical": { "$ref": "#/$defs/score" },
        "preservation": { "$ref": "#/$defs/score" },
        "crossModel": { "$ref": "#/$defs/score" },
        "teacher": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "reading": { "type": ["string", "null"] },
        "rank": { "type": ["integer", "null"], "minimum": 1 },
        "hypothesisCount": { "type": ["integer", "null"], "minimum": 1 },
        "sequenceScore": { "$ref": "#/$defs/score" },
        "avgLogprob": { "$ref": "#/$defs/score" },
        "beamConfidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "source": { "type": ["string", "null"] },
        "metadata": { "type": "object" }
      },
      "additionalProperties": true
    }
  }
}
